# Application Settings
# APP_NAME=Software Planner API
# APP_VERSION=0.1.0
# DEBUG=False

# Server Settings
# HOST=0.0.0.0
# PORT=8000

# API Settings
# API_PREFIX=/api/v1

# Planning Settings
# MAX_DESCRIPTION_BYTES=8192

# LLM Settings
# Required: API key for your LLM provider
# LLM_API_KEY=your-api-key-here

# Model identifier (examples: 'gpt-5.1', 'claude-sonnet-4.5', 'gemini-3.0-pro')
# LLM_MODEL=gpt-5.1

# Optional: Custom base URL for LLM API (for proxies or custom endpoints)
# LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds (default: 60)
# LLM_TIMEOUT=60

# Optional: Override the default system prompt
# LLM_SYSTEM_PROMPT=Your custom system prompt here

# CORS Settings
# WARNING: Default configuration is for development only
# In production, set allowed_origins to specific domains
# ALLOWED_ORIGINS=*
# ALLOWED_CREDENTIALS=False
# ALLOWED_METHODS=*
# ALLOWED_HEADERS=*
