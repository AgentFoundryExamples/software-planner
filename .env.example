# Application Settings
# APP_NAME=Software Planner API
# APP_VERSION=0.1.0
# DEBUG=False

# Server Settings
# HOST=0.0.0.0
# PORT=8000

# API Settings
# API_PREFIX=/api/v1

# Planning Settings
# MAX_DESCRIPTION_BYTES=8192

# ============================================================================
# LLM Settings
# ============================================================================
# The Software Planner uses LLM models to generate software specs.
# You can configure either:
# 1. Legacy single model configuration (LLM_API_KEY, LLM_MODEL, etc.)
# 2. Multi-provider model registry (MODELS_REGISTRY, DEFAULT_MODEL)

# ----------------------------------------------------------------------------
# Legacy Single Model Configuration (Backward Compatible)
# ----------------------------------------------------------------------------
# Use this for simple deployments with a single OpenAI model.

# Required: OpenAI API key
# Get your key from: https://platform.openai.com/api-keys
# Format: sk-... (starts with "sk-")
# SECURITY: Never commit this file with real credentials to version control!
# LLM_API_KEY=sk-your-actual-openai-api-key-here

# Optional: Model identifier (default: gpt-4)
# Recommended: gpt-5.1 for better results
# Other options: gpt-4, gpt-4-turbo
# Note: Only OpenAI models are currently supported in legacy mode
# LLM_MODEL=gpt-5.1

# Optional: Custom base URL for OpenAI-compatible endpoints
# Use this for: Azure OpenAI, custom proxies, or other compatible services
# Default: Uses standard OpenAI endpoint (https://api.openai.com/v1)
# Leave commented to use the default endpoint
# LLM_BASE_URL=https://your-custom-endpoint.com/v1

# Optional: Request timeout in seconds (default: 60)
# Increase if you experience timeout errors with complex descriptions
# Recommended range: 30-120 seconds
# This timeout applies per request attempt (retries get their own timeout)
# LLM_TIMEOUT=90

# Optional: Override the default system prompt (advanced users only)
# Default prompt enforces JSON-only output with required structure
# Warning: Custom prompts may break response parsing if they don't enforce
#          valid JSON output matching the expected schema
# Only modify if you understand the prompt engineering implications
# LLM_SYSTEM_PROMPT=Your custom system prompt here...

# ----------------------------------------------------------------------------
# Multi-Provider Model Registry (Advanced)
# ----------------------------------------------------------------------------
# Use this to configure multiple LLM providers with enable/disable toggles
# and declarative routing. The registry supports OpenAI, Anthropic, and Google.
#
# Configuration format (JSON):
# MODELS_REGISTRY={"logical_name": {"provider": "...", "model_id": "...", ...}}
#
# Example with multiple providers:
# MODELS_REGISTRY={
#   "gpt5-primary": {
#     "provider": "openai",
#     "model_id": "gpt-5.1",
#     "api_key_env": "OPENAI_API_KEY",
#     "enabled": true,
#     "timeout": 90,
#     "max_retries": 3
#   },
#   "claude-backup": {
#     "provider": "anthropic",
#     "model_id": "claude-sonnet-4.5",
#     "api_key_env": "ANTHROPIC_API_KEY",
#     "enabled": false,
#     "timeout": 60,
#     "max_retries": 3
#   },
#   "gemini-experimental": {
#     "provider": "google",
#     "model_id": "gemini-3.0-pro",
#     "base_url": "https://generativelanguage.googleapis.com/v1",
#     "api_key_env": "GOOGLE_API_KEY",
#     "enabled": false,
#     "timeout": 60,
#     "max_retries": 3
#   }
# }
#
# Required: Specify the default model to use (must be enabled)
# DEFAULT_MODEL=gpt5-primary

# ----------------------------------------------------------------------------
# Provider API Keys (for Model Registry)
# ----------------------------------------------------------------------------
# Set API keys for each provider you plan to enable in the registry.
# Only keys for enabled models are required at startup.

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key
# Get from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API Key (for Gemini)
# Get from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# ----------------------------------------------------------------------------
# Model Registry Configuration Guidelines
# ----------------------------------------------------------------------------
# 1. At least one model must be enabled in the registry
# 2. Exactly one model must be marked as the default (via DEFAULT_MODEL)
# 3. All enabled models must have their API key environment variable set
# 4. The default model must be enabled
# 5. Valid providers: "openai", "anthropic", "google"
# 6. Timeout must be >= 1 second
# 7. Max retries must be >= 0
#
# The service will fail to start if any of these conditions are violated,
# with clear error messages indicating what needs to be fixed.

# ============================================================================
# Troubleshooting LLM Issues
# ============================================================================
# Common problems and solutions:
#
# 1. Authentication errors (401):
#    - Verify LLM_API_KEY is set and correct (starts with "sk-")
#    - Check key is still valid in OpenAI dashboard
#
# 2. Timeout errors:
#    - Increase LLM_TIMEOUT (try 90 or 120)
#    - Simplify your project description
#    - Check network connection to OpenAI
#
# 3. Rate limit errors (429):
#    - Wait a few minutes before retrying
#    - Check OpenAI account limits and usage
#    - Consider upgrading your OpenAI plan
#
# 4. Model not found (404):
#    - Verify LLM_MODEL spelling (e.g., "gpt-5.1")
#    - Check model availability in your OpenAI account
#
# 5. Schema validation errors:
#    - Remove custom LLM_SYSTEM_PROMPT to use default
#    - Ensure custom prompt enforces required JSON structure
#
# See README.md "Troubleshooting LLM Issues" section for more details

# CORS Settings
# WARNING: Default configuration is for development only
# In production, set allowed_origins to specific domains
# ALLOWED_ORIGINS=*
# ALLOWED_CREDENTIALS=False
# ALLOWED_METHODS=*
# ALLOWED_HEADERS=*

# ============================================================================
# Database Settings
# ============================================================================
# PostgreSQL database configuration for job persistence.
# Jobs are stored in a PostgreSQL database for durability across restarts.
#
# You can configure the database connection in two ways:
# 1. Provide a complete DATABASE_URL (recommended for production)
# 2. Provide individual DATABASE_* settings (easier for development)

# ----------------------------------------------------------------------------
# Option 1: Complete Database URL (Recommended for Production)
# ----------------------------------------------------------------------------
# Provide a complete PostgreSQL connection URL. This overrides individual settings.
# Format: postgresql+asyncpg://user:password@host:port/database
# Example: postgresql+asyncpg://myuser:mypassword@db.example.com:5432/software_planner
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/software_planner

# ----------------------------------------------------------------------------
# Option 2: Individual Database Settings (Development)
# ----------------------------------------------------------------------------
# If DATABASE_URL is not provided, these individual settings are used.
# All settings must be provided for the database connection to work.

# Required: PostgreSQL database host (default: localhost)
# DATABASE_HOST=localhost

# Required: PostgreSQL database port (default: 5432)
# DATABASE_PORT=5432

# Required: PostgreSQL database name (default: software_planner)
# DATABASE_NAME=software_planner

# Required: PostgreSQL database user
# SECURITY: Never commit this file with real credentials to version control!
# DATABASE_USER=myuser

# Required: PostgreSQL database password
# SECURITY: Never commit this file with real credentials to version control!
# DATABASE_PASSWORD=mypassword

# ----------------------------------------------------------------------------
# Database Requirements and Permissions
# ----------------------------------------------------------------------------
# The database user must have the following permissions:
# - SELECT, INSERT, UPDATE on the jobs table
# - CREATE TABLE (only for running migrations)
# - CREATE INDEX (only for running migrations)
#
# For production deployments:
# 1. Create the database: CREATE DATABASE software_planner;
# 2. Create a user: CREATE USER myuser WITH PASSWORD 'mypassword';
# 3. Grant permissions: GRANT ALL PRIVILEGES ON DATABASE software_planner TO myuser;
# 4. Run migrations: alembic upgrade head
#
# For development:
# 1. Use Docker: docker run -d -p 5432:5432 -e POSTGRES_USER=myuser -e POSTGRES_PASSWORD=mypassword -e POSTGRES_DB=software_planner postgres:17
# 2. Configure environment variables above
# 3. Run migrations: alembic upgrade head
#
# See README.md "Database Setup" section for detailed instructions.

# ----------------------------------------------------------------------------
# Migration Management
# ----------------------------------------------------------------------------
# To run database migrations:
# 1. Ensure database is running and accessible
# 2. Set database environment variables (DATABASE_URL or individual settings)
# 3. Run: alembic upgrade head
#
# To check current migration version:
# alembic current
#
# To create a new migration:
# alembic revision -m "description_of_changes"
#
# Migrations are idempotent - running the same migration twice is safe.
# The alembic_version table tracks which migrations have been applied.

